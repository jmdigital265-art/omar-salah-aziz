# PostgreSQL connection string (Neon / Supabase / any Postgres)
DATABASE_URL=

# Random 32-byte secret used to HMAC admin session tokens
# Generate: openssl rand -base64 32
SESSION_SECRET=

# First-boot admin password — hashed (scrypt) into the database on the first
# login API call; never stored in source code. Change it from the admin panel.
INITIAL_ADMIN_PASSWORD=

# Admin session lifetime in hours (default 12)
ADMIN_SESSION_TTL_HOURS=12
